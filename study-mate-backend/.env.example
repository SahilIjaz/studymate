# Copy to .env and fill in. Every value has a sensible default except the API key.

# --- LLM ------------------------------------------------------------------
# auto | gemini | claude | mock. auto picks gemini when GEMINI_API_KEY is set.
LLM_PROVIDER=auto

# Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_THINKING_LEVEL=low                        # low keeps answers starting in ~2 s
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest   # used when the primary is overloaded
GEMINI_FAST_MODEL=gemini-flash-lite-latest       # query rewriting, suggestions

# Claude (optional alternative)
# ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_FAST_MODEL=claude-haiku-5-5
CLAUDE_EFFORT=medium
CLAUDE_MAX_TOKENS=8192
CLAUDE_SERVER_FALLBACKS=true
# LLM_MOCK=true                  # dev only: canned streamed answers, no key needed

# --- Embeddings -----------------------------------------------------------
# auto | gemini | fastembed | voyage | hashed
# auto = voyage if keyed, else gemini if keyed, else local fastembed.
EMBEDDING_PROVIDER=auto
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_CACHE_DIR=data/models   # downloaded model files (default: DATA_DIR/models)
# VOYAGE_API_KEY=pa-...
# VOYAGE_MODEL=voyage-3.5-lite

# --- Service --------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
DATA_DIR=data
CORS_ORIGINS=http://localhost:3000
# APP_API_KEY=change-me          # when set, clients must send X-API-Key

# --- Limits ---------------------------------------------------------------
MAX_UPLOAD_MB=20
MAX_PAGES=300
MAX_DOCS_PER_WORKSPACE=20
RATE_LIMIT_ASK_PER_MINUTE=12
RATE_LIMIT_UPLOAD_PER_MINUTE=6
